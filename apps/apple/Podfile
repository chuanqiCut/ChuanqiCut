# ChuanqiCut — iOS/macOS App 的 CocoaPods 依赖
#
# ⚠️ 状态（2026-09-30）：本文件是**模板**。
#    仓库里还没有 Xcode 工程（apps/apple/CMakeLists.txt 只是占位 target，
#    真实工程由 UIA-001/UIA-002 建立）。建立工程后，把下面的 target 名改成
#    工程里实际的 target 名即可。
#
# 分工（详见 docs/COCOAPODS.md）：
#   * **SDK 层**走本 Podfile：C++20 内核 + ObjC++ PAL + Swift 绑定（需要 vendored
#     二进制、C++ 标准、系统框架 —— CocoaPods 擅长，SPM 别扭）
#   * **UI 层**三方库：Pod 与 SPM 都行，但**同一库不要两边都引**
#     （会出重复符号）。UI 层纯 Swift 库建议走 SPM（Xcode 的 Package Dependencies）。

platform :ios, '16.0'

# 不启用 use_frameworks!：ChuanqiCut 是静态库（libChuanqiCut.a），
# 静态链接能避免动态库带来的启动开销与签名问题。
# 若某个三方库强制要求动态 framework，再改成 `use_frameworks! :linkage => :static`。

target 'ChuanqiCutApp' do
  # ---- SDK 层 ----
  # 默认 Binary 模式：链接预构建 XCFramework，不现场编译 C++ 内核。
  # 前置：tools/build/build_core_apple.sh --config=Release && bindings/swift/prepare.sh
  pod 'ChuanqiCut', :path => '../..'

  # 调试内核时改用源码模式（现场编译 C++/ObjC++，会明显变慢）：
  #   pod 'ChuanqiCut/Source', :path => '../..'

  # ---- UI 层三方库（按需增删）----
  # 例：pod 'SomeUILibrary', '~> 1.0'
  # 纯 Swift 的 UI 库更建议走 SPM：Xcode → Package Dependencies 里加，
  # 与这里的 Pod 依赖可以共存。
end

# macOS App：平台基线不同（ADR-0010 是 macOS 15.4，不是 iOS 的 16）
target 'ChuanqiCutMacApp' do
  platform :osx, '15.4'
  pod 'ChuanqiCut', :path => '../..'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # 与项目门禁一致：SDK 层的编译设置以 cmake/CompileOptions.cmake 为准，
      # 这里只兜底 C++20。
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] ||= 'c++20'
    end
  end
end
