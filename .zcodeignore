# ChuanqiCut — 仓库忽略规则（INFRA-001 建立）
# 构建目录：cmake -S . -B build 的产物不入库
# ⚠️ 必须写成 `/build/` 锚定仓库根。
#    2026-09-29 发现此处理曾有第二条裸 `build/`（匹配**任意层级**的 build 目录），
#    导致 `tools/build/` 被连带忽略——三个构建脚本和一个 smoke_link.cpp 从未入库，
#    clone 出来的人拿不到构建入口，而交接文档还在教人去跑它们。
#    裸模式造成的误忽略是静默的：`git status` 干净，但文件实际不在版本库里。
/build/
cmake-build-*/
out/

# 编译产物
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.xcframework/
*.framework/

# 编辑器/OS
.DS_Store
*.swp
*~

# shader 生成产物（ARCH-001 §8：shaders/generated 为构建产物，不入库）
shaders/generated/

# 第三方源码 checkout 与构建产物（DEPS-002 / DEPS-010）
# 源码不进仓库；构建产物（*.a 等）已被上面的编译产物规则忽略，这里再显式忽略目录
third_party/src/
prebuilt/

# 临时目录：tempfile.mkdtemp() 若在仓库内被调用且进程被中断，会留下 tmpXXXXXXXX/ 形态的中间产物
# （2026-09-24 因 worker 被 429 打断，实际泄漏过 5 个、共约 8.5MB PNG）。
# golden manifest 有 "keep total <=10MB" 的提交策略，这类垃圾一旦入库直接超标，故显式防御。
tmp*/

# Swift 绑定：xcframework 副本与 SPM 构建目录（均为构建产物，clone 后自行生成）
# 生成方式：tools/build/build_core_apple.sh --config=Release && bindings/swift/prepare.sh
bindings/swift/Frameworks/
bindings/swift/.build/

# Apple App 工程（UIA-002 建，INFRA-009 拆为 ios/ 与 mac/ 两个独立工程）
# Xcode 工程与 workspace 均为生成产物，不入库：
#   cd apps/apple/ios && xcodegen generate && bundle install && bundle exec pod install
#   cd apps/apple/mac && xcodegen generate && bundle install && bundle exec pod install
# 注意：两个目录的 Gemfile.lock **必须入库**（钉住工具链，见 pitfalls P12）。
apps/apple/ios/ChuanqiCut.xcodeproj/
apps/apple/ios/ChuanqiCut.xcworkspace/
apps/apple/mac/ChuanqiCut.xcodeproj/
apps/apple/mac/ChuanqiCut.xcworkspace/
# SPM 构建目录（SharedUI 包仅保留作 swift test 测试宿主，同 bindings/swift/.build）
apps/apple/packages/SharedUI/.build/
# Xcode 用户态状态与索引
xcuserdata/
DerivedData/
# CocoaPods 本地环境：bundle 的 gems 缓存与配置（clone 后 bundle install 重建）
# Gemfile 本身入库；vendor/ 与 .bundle/ 是本机缓存，不入库
.bundle/
vendor/
# CocoaPods 产物目录（由 pod install 生成，clone 后自行重建）
Pods/
# Xcode 构建产物（apps/apple/{ios,mac}/build/，xcodebuild 生成，76MB+ 量级）
# ⚠️ 用 * 通配**而非裸 build/**：裸写会匹配任意层级，历史上曾因此把
#    tools/build/ 一并忽略，导致三个构建脚本与 smoke_link.cpp 从未入库。
apps/apple/*/build/
# ZCode 会话本地数据
.zcode/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
# 自定义规则写在下方（本行提示可删除）
