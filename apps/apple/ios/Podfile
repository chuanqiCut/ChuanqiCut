# ChuanqiCut iOS App — CocoaPods 依赖（INFRA-009）
#
# ⚠️ iOS 项目独立维护本 Podfile（owner 决策 2026-10-02）：apps/apple/ios 与
#    apps/apple/mac 各自一份 Podfile + Gemfile，两端可独立升级 CocoaPods。
#    工具链版本由同目录 Gemfile.lock 钉住，一律 `bundle exec pod ...`，
#    不要裸跑 `pod`（会绕过锁定）。
#
# 分工（详见 docs/COCOAPODS.md）：SDK 层 + SharedUI 都走 pod，App 不使用 SPM。
# 同一库不要既引 pod 又引 SPM（会重复符号）。
#
# Engine 拆为两层（ADR-0033）：ChuanqiCutCore（原 CChuanqiCut，ADR-0038 更名）= C/C++20 + Apple Platform；
# ChuanqiCutEngine = Swift adapter。两个本地 spec 必须都显式给 :path。
source 'https://cdn.cocoapods.org'

platform :ios, '16.0'

# Swift pod 以静态库集成需要 modular headers（否则 App 侧 import 不到模块）。
use_modular_headers!

target 'ChuanqiCutApp' do
  pod 'ChuanqiCutCore', :path => '../../../engine'
  pod 'ChuanqiCutFFmpeg', :path => '../../../engine'
  pod 'ChuanqiCutEngine', :path => '../../../api/swift'
  pod 'SharedUI', :path => '../../../ui/SharedUI'
  # 功能 Pod（ADR-0031 分治，2026-10-07 全域完成）：Player/Camera(仅iOS)/Import/Editor
  pod 'ChuanqiCutPlayer', :path => '../../../ui/ChuanqiCutPlayer'
  # Camera 阶段 4 提前（2026-10-07，传哲指定）：iOS 专属，mac Podfile 不引
  pod 'ChuanqiCutCamera', :path => '../../../ui/ChuanqiCutCamera'
  pod 'ChuanqiCutImport', :path => '../../../ui/ChuanqiCutImport'
  # 轨道区接 TimelineKit（UIKit-only 本地 Pod）→ 必须引 iOS 专属子 spec；
  # macOS 端 Podfile 引的是默认子 spec `Core`（见 ChuanqiCutEditor.podspec 头注释）。
  pod 'ChuanqiCutEditor/TimelineKitTrack', :path => '../../../ui/ChuanqiCutEditor'
  # TimelineKit 本地开发 Pod（独立 Swift/UIKit 时间线组件）
  # ⚠️ 仓库外的本机路径，**故意不收编**（ADR-0044 决策 ①：将来落 ui/TimelineKit）。
  #    CocoaPods 缺目录时只报 "No podspec found for `TimelineKit`"，不给出这是外部组件的线索，
  #    换机/新会话极易误判成本仓搬家坏了 —— 故在此显式守卫（INFRA-031）。
  timelinekit_dir = File.expand_path('../../../../ChatGPT/zui', __dir__)
  unless File.exist?(File.join(timelinekit_dir, 'TimelineKit.podspec'))
    raise "TimelineKit 是仓库外的独立组件，本机未准备好：#{timelinekit_dir}\n" \
          "        该目录须含 TimelineKit.podspec（决策 ①：本轮不并入 ui/，收编另开卡）。" \
          "        换机器时把 :path 指向你自己的 TimelineKit checkout 即可。\n" \
          "        风险与收编计划见 docs/tasks/TODO-POOL-门禁真机待办池.md 条目 [20]。"
  end
  pod 'TimelineKit', :path => '../../../../ChatGPT/zui'
  pod 'SnapKit', '~> 5.7.0'
  pod 'Kingfisher'
  pod 'Alamofire'
  pod 'SDWebImage'
#  pod 'ReactiveCocoa'
  pod 'RxSwift'
#  pod 'YYKit'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # 与项目门禁一致：SDK 层的编译设置以 cmake/CompileOptions.cmake 为准，
      # 这里只兜底 C++20。
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] ||= 'c++20'
    end
  end
end
